# AION2-KINA 临时隔离验证环境变量
# 来源：Dokploy 线上 kina compose 的 env（2026-09-18 抓取）
#
# ⚠️ 关键：这里【绝对不能出现 NODE_ENV】
#    Vite 仅在 NODE_ENV 未设时才走 development 管线；
#    一旦设为 production，vinext dev 行为会偏离 db11 实测形态。

X_LOCAL_EXPLORER=false
WRANGLER_WRITE_LOGS=false

ADMIN_AUTH_SECRET=<REPLACE_ME>
ADMIN_PASSWORD_HASH=<REPLACE_ME>
ADMIN_API_KEY=<REPLACE_ME>

ANALYTICS_PSEUDONYM_KEY=<REPLACE_ME>
ANALYTICS_IP_ENCRYPTION_KEY=<REPLACE_ME>

# 临时验证站使用自己的域名，避免与线上 SITE_URL 冲突导致跳转串台
SITE_URL=https://test.aion2kina.com
NEXT_PUBLIC_SITE_URL=https://test.aion2kina.com

# 构建时保留 dist/client/map-assets/（db11 形态需要）
KEEP_LOCAL_MAP_ASSETS=1

# Vite allowedHosts 额外白名单（逗号分隔）
# 临时验证环境需要，生产不设此项
EXTRA_ALLOWED_HOSTS=test.aion2kina.com
