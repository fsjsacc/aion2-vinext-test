# AION2 KINA local environment template
# Basic local development does not require any environment variables.
# Copy this file to the project root as .env.local only when a feature needs it.
# Never put real production secrets in Git, documentation, chat, or command arguments.

# Keep bundled map assets when building a local production preview.
KEEP_LOCAL_MAP_ASSETS=1

# Local admin configuration. Server-only, required for /admin/ access.
# ADMIN_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_OF_32_TO_512_BYTES
# ADMIN_PASSWORD_HASH=SHA256_HEX_HASH_OF_YOUR_ADMIN_PASSWORD

# Optional first-party analytics configuration. Server-only.
# ANALYTICS_PSEUDONYM_KEY=GENERATE_AT_LEAST_32_RANDOM_BYTES
# ANALYTICS_IP_ENCRYPTION_KEY=GENERATE_EXACTLY_32_RANDOM_BYTES_AS_BASE64URL

# Production origin only. Leave unset for http://localhost development.
# When used, both values must be the same bare HTTPS origin.
# SITE_URL=https://www.example.com
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional map source and local data-generation controls.
# AION2_MAP_SOURCE_DIR=C:\path\to\external\map-source
# MAP_TILE_SOURCE_BASE_URL=https://assets.example.com
# MAP_TILE_SYNC_CONCURRENCY=8
# MAP_TILE_SYNC_MAX_ATTEMPTS=3
# MAP_TILE_SYNC_RETRY_DELAY_MS=500
# CONTENT_RELEASE_AS_OF=2026-08-03

# Preferred Sites-managed R2 release transport. Do not configure for ordinary local work.
# MAP_RELEASE_ENDPOINT=https://www.example.com
# MAP_RELEASE_UPLOAD_TOKEN=GENERATE_A_STRONG_ENVIRONMENT_ONLY_TOKEN
# MAP_RELEASE_UPLOAD_CONCURRENCY=4
# MAP_RELEASE_MAX_ATTEMPTS=3
# MAP_RELEASE_BOOTSTRAP_TOKEN=FIRST_RELEASE_ONLY_STRONG_TOKEN
# MAP_RELEASE_BOOTSTRAP_VERSION=sha256-EXACT_CURRENT_VERSION
# MAP_RELEASE_BOOTSTRAP_RETIRED=1

# PostgreSQL content/database publication only.
# PGHOST=
# PGHOSTADDR=
# PGPORT=5432
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGSSLMODE=require

# Direct R2/S3 recovery transport only. Prefer Sites-managed R2 for normal releases.
# R2_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_SESSION_TOKEN=
# R2_S3_REGION=auto
# R2_UPLOAD_CONCURRENCY=4
# R2_S3_MAX_ATTEMPTS=3
# R2_S3_FORCE_PATH_STYLE=false

